<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DrivoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drivo">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="@string/auth_login_title"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.address.AddressListActivity"
            android:exported="false"
            android:label="@string/address_list_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.address.AddEditAddressActivity"
            android:exported="false"
            android:label="@string/address_edit_title_new"
            android:parentActivityName=".ui.address.AddressListActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.destination.SetDestinationActivity"
            android:exported="false"
            android:label="@string/set_destino_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.destination.PickLocationOnMapActivity"
            android:exported="false"
            android:label="@string/pick_location_title"
            android:parentActivityName=".ui.destination.SetDestinationActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.price.ConfirmPriceActivity"
            android:exported="false"
            android:label="@string/confirm_price_title"
            android:parentActivityName=".ui.destination.SetDestinationActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.search.SearchingDriverActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.price.ConfirmPriceActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.trip.ActiveTripActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.trip.FinishedTripActivity"
            android:exported="false"
            android:label="@string/finished_trip_title"
            android:theme="@style/Theme.Drivo" />

        <!-- Pantalla de prueba del SDK de Google Maps (Kotlin/Compose) — ver PROJECT_RULES.md. No es launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />
    </application>

</manifest>