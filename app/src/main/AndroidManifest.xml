<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permiso normal (no pide diálogo): habilita ConnectivityManager.registerNetworkCallback,
         con el que la app se entera de recuperar la señal sin sondear — ver
         SystemConnectivityRepository. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DrivoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drivo">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="com.bng.drivo.TRANSPORT_API_BASE_URL"
            android:value="${TRANSPORT_API_BASE_URL}" />

        <!-- Solo para pasarle una content:// Uri temporal a la app de cámara del sistema al
             tomar una foto de documento (DriverRegistrationActivity) — no expone nada más. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.bng.drivo.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RoleSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="@string/auth_login_title"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.auth.CompleteProfileActivity"
            android:exported="false"
            android:label="@string/complete_profile_title"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverRegistrationActivity"
            android:exported="false"
            android:label="@string/driver_reg_title"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverHomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverActiveTripActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverEarningsActivity"
            android:exported="false"
            android:label="@string/driver_earnings_title"
            android:parentActivityName=".ui.driver.DriverHomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverSettingsActivity"
            android:exported="false"
            android:label="@string/driver_settings_title"
            android:parentActivityName=".ui.driver.DriverHomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.driver.DriverSecurityActivity"
            android:exported="false"
            android:label="@string/security_title"
            android:parentActivityName=".ui.driver.DriverHomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.security.SeguridadActivity"
            android:exported="false"
            android:label="@string/security_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.address.AddressListActivity"
            android:exported="false"
            android:label="@string/address_list_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.address.AddEditAddressActivity"
            android:exported="false"
            android:label="@string/address_edit_title_new"
            android:parentActivityName=".ui.address.AddressListActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.destination.PickLocationOnMapActivity"
            android:exported="false"
            android:label="@string/pick_location_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.price.ConfirmPriceActivity"
            android:exported="false"
            android:label="@string/confirm_price_title"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.search.SearchingDriverActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:parentActivityName=".ui.price.ConfirmPriceActivity"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.trip.ActiveTripActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <activity
            android:name=".ui.trip.FinishedTripActivity"
            android:exported="false"
            android:label="@string/finished_trip_title"
            android:theme="@style/Theme.Drivo" />

        <!-- Pantalla de prueba del SDK de Google Maps (Kotlin/Compose) — ver PROJECT_RULES.md. No es launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Drivo" />

        <service
            android:name=".service.DrivoFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>