<?xml version="1.0" encoding="utf-8"?>
<!-- Píldora neutra para acciones flotantes con texto sobre el mapa (p. ej. "Navegar con Waze").
     Mismo par superficie/borde que bg_dot_outlined, que es el de los flotantes redondos, para que
     todo lo que flota sobre el mapa se lea como una sola familia. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
    <corners android:radius="22dp" />
</shape>
