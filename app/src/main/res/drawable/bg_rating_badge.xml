<?xml version="1.0" encoding="utf-8"?>
<!-- Pastilla de la calificación, montada sobre el borde inferior del avatar en la cabecera del
     cajón. El borde no es decorativo: va del color de la superficie del cajón, y es lo que
     recorta la pastilla contra el círculo del avatar para que se lea como una pieza encima y no
     como una mancha pegada al canto. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSecondaryContainer" />
    <stroke
        android:width="2dp"
        android:color="?attr/colorSurface" />
    <corners android:radius="20dp" />
</shape>
