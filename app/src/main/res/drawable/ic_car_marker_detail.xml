<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="34dp"
    android:viewportWidth="22"
    android:viewportHeight="34">
    <!--
        Capa de detalle: va encima de la carrocería, que MarkerIconFactory tiñe. Todos los colores
        salen de @color y tienen variante en values-night porque tienen que contrastar contra la
        carrocería, y esa se invierte con el tema — con blanco fijo, en tema oscuro quedaba blanco
        sobre blanco y el coche perdía todo el detalle.

        El borde va primero, con el mismo pathData que ic_car_marker_body.xml (solo trazo, sin
        relleno), para quedar debajo de parabrisas, techo y llantas.
    -->
    <path
        android:strokeColor="@color/drivo_vehicle_outline"
        android:strokeWidth="0.8"
        android:pathData="M8,2 L14,2 A4,4 0 0 1 18,6 L18,26 A4,4 0 0 1 14,30 L8,30 A4,4 0 0 1 4,26 L4,6 A4,4 0 0 1 8,2 Z" />
    <!-- Llantas: la señal más clara de "esto es un coche", no solo una silueta. -->
    <path
        android:fillColor="@color/drivo_vehicle_wheel"
        android:pathData="M3.7,7.6 L3.9,7.6 A1.1,1.1 0 0 1 5,8.7 L5,11.1 A1.1,1.1 0 0 1 3.9,12.2 L3.7,12.2 A1.1,1.1 0 0 1 2.6,11.1 L2.6,8.7 A1.1,1.1 0 0 1 3.7,7.6 Z" />
