<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- El botón va en la misma columna que la tarjeta y no suelto sobre el mapa: así queda
         siempre justo encima de ella sin que nadie tenga que medir su alto, que cambia con la
         fase del viaje (el cronómetro de cortesía la hace crecer, el precio también). -->
    <!-- Todo lo que tapa el mapa por abajo, en un solo bloque: ActiveTripActivity mide su alto y
         se lo pasa al mapa como padding, para que la cámara encuadre contra el hueco que queda a
         la vista y no contra la pantalla entera. Sin eso, centrar al conductor lo dejaba centrado
         en la pantalla — es decir, detrás de esta tarjeta. -->
    <LinearLayout
        android:id="@+id/container_trip_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Aparece en cuanto se sabe dónde está el coche y se queda las tres fases: mientras
             viene, mientras espera y durante el trayecto. El mapa se puede arrastrar en todas
             ellas, y sin esto alejarse para mirar alrededor era un viaje de ida. -->
        <ImageButton
            android:id="@+id/btn_locate_driver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_dot_outlined"
            android:contentDescription="@string/active_trip_locate_driver"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_locate_driver"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface"
            tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar con la calificación montada en el borde inferior, misma pieza que la
                     cabecera del cajón (part_nav_avatar_rating.xml): mismo fondo, mismo recorte
                     contra el círculo y el mismo texto, que lo compone NavHeaderRating para las
                     dos. En la línea del nombre competía con él; aquí no compite con nada.

                     El marco es wrap_content y la pastilla se ancla dentro, sin márgenes
                     negativos: los ViewGroup recortan a sus hijos y se perdería justo lo que
                     sobresale. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/text_driver_avatar"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:gravity="center"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="JP" />

                    <!-- Nace GONE: sin calificación no se reserva hueco. -->
                    <TextView
                        android:id="@+id/text_driver_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_rating_badge"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="★ 4.6"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_driver_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Juan P." />

                    <TextView
                        android:id="@+id/text_driver_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        tools:text="Nissan Versa Blanco · YKV-889" />
                </LinearLayout>
            </LinearLayout>

            <!-- A diferencia del origen (que ya cumplió su función una vez que el pasajero sube),
                 el destino es una referencia que quiere poder revisar en cualquier momento del
                 viaje: se queda visible en las tres fases (conductor en camino, esperando, en
                 curso), no solo cuando confirma la tarifa. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/incoming_request_destination_label"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/text_trip_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Casa" />

                <!-- Solo cuando el destino salió de una dirección guardada: arriba va el nombre
                     que le puso el pasajero y aquí la dirección, que es la que de verdad dice a
                     dónde va. Elegido de cualquier otra forma esta línea no existe y arriba queda
                     la dirección sola, como siempre. Lo decide ActiveTripActivity. -->
                <TextView
                    android:id="@+id/text_trip_destination_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Sur 17 851, Centro, 94300 Orizaba, Ver."
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_call_driver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_call"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_trip_call_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_message_driver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_message"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_trip_message_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_share_trip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_share"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_trip_share_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- S.O.S. vive en esta misma fila, junto a "Compartir" — antes era una píldora
                     flotante sobre el mapa, separada del resto de acciones del viaje. Mismo
                     patrón contenedor+ícono+texto que sus vecinos (y no un TextView con
                     drawableStart) para que LoadingButtonHelper pueda animar el spinner en
                     text_sos_badge_label sin pisar el ícono fijo del shield. Se queda rojo (a
                     diferencia de call/message/share) porque es la única acción de la fila que no
                     es informativa: manda una alerta real. -->
                <LinearLayout
                    android:id="@+id/btn_sos_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/drivo_error" />

                    <TextView
                        android:id="@+id/text_sos_badge_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_trip_sos"
                        android:textColor="@color/drivo_error"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fases "conductor en camino" / "conductor esperando": sin precio ni S.O.S. todavía. -->
            <LinearLayout
                android:id="@+id/group_before_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceVariant"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/text_trip_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="@string/active_trip_status_en_route_title" />

                    <TextView
                        android:id="@+id/text_trip_status_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        tools:text="@string/active_trip_status_waiting_subtitle" />
                </LinearLayout>

                <!-- Solo en DRIVER_ARRIVED: los 5 min de cortesía. Ver PickupWaitTimer. -->
                <include
                    android:id="@+id/group_pickup_wait"
                    layout="@layout/view_pickup_wait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <!-- Cancelar solo existe antes de IN_PROGRESS (lo que permite el contrato), y
                     siempre pasa por el diálogo de confirmación. Botón de texto para que no
                     compita con nada: es una salida, no una acción del viaje. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_trip"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/active_trip_cancel_button"
                    android:textAllCaps="false"
                    android:textColor="@color/drivo_error"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Fase "viaje en curso": precio acordado + S.O.S. + finalizar. -->
            <LinearLayout
                android:id="@+id/group_trip_in_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Precio y llegada comparten fila y fondo: son las dos cosas que el pasajero
                     mira durante el trayecto, y separarlas en dos tarjetas alargaría el modal
                     justo cuando el mapa es lo que importa. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceVariant"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/active_trip_price_label"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/text_trip_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="$290.00" />
                    </LinearLayout>

                    <!-- Se oculta entero mientras no haya ETA: una etiqueta "Llegada estimada"
                         sobre un hueco promete un dato que no está. Ver ActiveTripActivity. -->
                    <LinearLayout
                        android:id="@+id/group_trip_eta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/active_trip_eta_label"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/text_trip_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="~18 min" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
