<?xml version="1.0" encoding="utf-8"?>
<!-- Viaje activo del conductor con el mismo esqueleto que el resto del rediseño: un solo mapa a
     pantalla completa, flotantes arriba y un modal abajo que cambia de panel según la fase. Antes
     eran dos MaterialCardView flotantes con márgenes propios que se alternaban a mano.

     El modal no es arrastrable: sus dos paneles caben enteros y no guardan nada que mostrar al
     expandirlos. Ver DriverActiveTripActivity. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- S.O.S. y Waze en la misma fila que los flotantes del resto de la app (mismo alto de 44dp
         y mismo margen; el inset superior lo pone DriverActiveTripActivity.applyTopInsets). Son
         píldoras con texto y no botones redondos porque las dos son acciones que no se pueden
         confundir con un icono: una manda ayuda y la otra abre otra app. -->
    <TextView
        android:id="@+id/btn_trip_sos"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_error"
        android:drawableStart="@drawable/ic_shield"
        android:drawablePadding="6dp"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="@string/active_trip_sos"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:drawableTint="@android:color/white" />

    <!-- Fondo invertido a propósito (drivo_inverse_surface, no colorSurface): a diferencia de los
         demás flotantes, este necesita destacar sobre el mapa sin importar el tema activo — con
         colorSurface se mimetiza con el propio tema y pierde contraste contra el mapa. -->
    <TextView
        android:id="@+id/btn_trip_waze"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_inverse"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="@string/driver_trip_waze_button"
        android:textColor="@color/drivo_inverse_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <FrameLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/panel_driver_trip"
                layout="@layout/panel_driver_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/panel_driver_cobro"
                layout="@layout/panel_driver_cobro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
