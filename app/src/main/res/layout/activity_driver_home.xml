<?xml version="1.0" encoding="utf-8"?>
<!-- Home del conductor sobre un único mapa, con el mismo esqueleto que fragment_home.xml del
     pasajero: mapa a pantalla completa, botones flotantes redondos arriba, radar centrado en el
     hueco visible y un modal persistente abajo que cambia de panel según el estado. Antes esto
     era una barra superior descuadrada + tarjetas sueltas con márgenes propios.

     El modal no es arrastrable en ningún estado del conductor (a diferencia del paso IDLE del
     pasajero): ninguno de sus paneles tiene contenido de sobra que mostrar al expandirlo, así
     que se ajusta al alto de su panel y ahí se queda. Ver DriverHomeActivity. -->
<!-- El menú es un drawer y no un modal: es el menú general de la app (Inicio / Ganancias /
     Configuración / Seguridad), igual que en el lado del pasajero, no un menú de esta pantalla. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Sin <fragment> estático a propósito: crear el SupportMapFragment ya empieza a cargar
         tiles y puede disparar el permiso de ubicación, y un conductor sin aprobar no debe ver
         ninguna de las dos cosas. Se agrega mediante FragmentTransaction solo cuando
         DriverHomeActivity confirma "approved" — ver setUpMapAndLocationIfNeeded(). -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/driver_home_menu_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_menu"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <!-- Mismo botón propio que el pasajero (el del SDK se queda apagado) para que los dos
         flotantes compartan forma, tamaño y fila. -->
    <ImageButton
        android:id="@+id/btn_my_location"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/home_my_location_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_my_location"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <!-- Los viajes a los que el conductor ya se postuló, apilados bajo la fila de flotantes.

         Van sobre el mapa y no dentro del modal a propósito: ofertar no lo bloquea —sigue
         recibiendo y evaluando otras solicitudes en el modal— así que sus ofertas en curso tienen
         que quedarse a la vista sin disputarle ese espacio. Son como mucho tres, el mismo tope que
         impone el servidor (max_live_offers_per_driver). El margen superior lo fija
         DriverHomeActivity.applyTopInsets: inset + la fila de botones + un respiro. -->
    <LinearLayout
        android:id="@+id/container_offer_banners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical" />

    <!-- Radar del paso SEARCHING. Se centra en el hueco visible del mapa, no en la pantalla:
         DriverHomeActivity.updateMapViewport le da un margen inferior igual al alto del modal para que no quede medio
         tapado por él. Se oculta en cuanto llega una oferta, que pasa a ser el foco.

         Sin fondo ni contenedor con padding a propósito: los anillos flotan directamente sobre el
         mapa. Antes había un velo blanco redondeado detrás, y como los anillos crecen al animarse
         (hasta 1.15x = 184dp) mientras el velo medía lo mismo que su estado en reposo, la onda se
         "cortaba" contra ese borde justo antes de desvanecerse. Por eso el contenedor mide 200dp
         y los anillos 160dp: la onda cabe entera en su punto más grande y termina de desvanecerse
         sin tocar ningún borde. Si se cambia la escala máxima de la animación, hay que subir
         también este 200dp. -->
    <FrameLayout
        android:id="@+id/layout_radar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:visibility="gone">

        <View
            android:id="@+id/radar_ring_outer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:alpha="0.15"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/drivo_success" />

        <View
            android:id="@+id/radar_ring_inner"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/drivo_success" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/drivo_success" />
    </FrameLayout>

    <!-- Estados no aprobados (borrador / en revisión / rechazado / suspendido). No usa el modal:
         en estos estados no hay mapa detrás que valga la pena dejar a la vista, y una tarjeta
         centrada deja claro que no hay nada más que hacer en esta pantalla todavía. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_not_approved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/icon_not_approved"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:contentDescription="@null"
                android:padding="16dp"
                android:src="@drawable/ic_clock"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/text_not_approved_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Tu solicitud está en revisión" />

            <TextView
                android:id="@+id/text_not_approved_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                tools:text="Ya recibimos tus documentos." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_not_approved_action"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingVertical="12dp"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="26dp"
                tools:text="Actualizar estado" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progress_gate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <!-- Un solo hijo con los tres paneles: solo uno visible a la vez y el modal se ajusta a
             su alto (DriverHomeActivity.updateSheetStops). Cambiar de estado es un fundido
             cruzado dentro del modal, nunca una pantalla nueva. -->
        <FrameLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/panel_driver_connect"
                layout="@layout/panel_driver_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/panel_driver_request"
                layout="@layout/panel_driver_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Mismos avisos de conectividad que el pasajero, en la misma fila que los dos flotantes
         (44dp de alto, 60dp de margen a cada lado para no invadirlos). Aquí pesan más todavía:
         un conductor sin señal deja de reportar ubicación y de recibir solicitudes. -->
    <TextView
        android:id="@+id/banner_offline"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_error"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_offline"
        android:textColor="?attr/colorOnError"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/banner_online"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_online"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_restored"
        android:textColor="@color/drivo_on_success"
        android:textSize="13sp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Mismos ajustes de píldora que el NavigationView del pasajero (ver activity_home.xml):
         estilo "Keep", pegada al borde izquierdo y con 56dp de alto por item. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:itemMinHeight="56dp"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Drivo.NavigationView.Item"
        app:itemShapeInsetBottom="0dp"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetStart="0dp"
        app:itemShapeInsetTop="0dp"
        app:headerLayout="@layout/nav_header_driver"
        app:menu="@menu/driver_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
