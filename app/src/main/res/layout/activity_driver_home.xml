<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Sin <fragment> estático a propósito: crear el SupportMapFragment ya empieza a cargar
         tiles y puede disparar el permiso de ubicación, y un conductor sin aprobar no debe ver
         ninguna de las dos cosas. Se agrega mediante FragmentTransaction solo cuando
         DriverHomeActivity confirma "approved" — ver setUpMapAndLocationIfNeeded(). -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="@string/driver_home_menu_description"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_menu_hamburger" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <TextView
                android:id="@+id/text_status_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="$ 350.00 MXN" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/radar_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:visibility="gone">

        <View
            android:id="@+id/radar_ring_outer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/drivo_success"
            android:alpha="0.15" />

        <View
            android:id="@+id/radar_ring_inner"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/drivo_success"
            android:alpha="0.25" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_not_approved"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/text_not_approved_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Tu solicitud está en revisión" />

            <TextView
                android:id="@+id/text_not_approved_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                tools:text="Te avisaremos por notificación cuando la revisemos." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progress_gate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:cornerRadius="30dp" />

        <TextView
            android:id="@+id/text_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_incoming_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/text_incoming_avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:gravity="center"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="EG" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_incoming_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Esteban G." />

                    <TextView
                        android:id="@+id/text_incoming_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/drivo_secondary"
                        android:textSize="13sp"
                        tools:text="★ 5.0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_incoming_offer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="$ 278.00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/incoming_request_cash_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/incoming_request_pickup_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_incoming_pickup_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    tools:text="A 2.5 km (6 min) del pasajero" />

                <TextView
                    android:id="@+id/text_incoming_dropoff_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Plaza Valle, Orizaba" />

                <TextView
                    android:id="@+id/text_incoming_trip_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/drivo_error"
                    android:textSize="13sp"
                    tools:text="Viaje de 14 km" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_incoming_counter_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/incoming_request_counter_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_incoming_counters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_incoming_ignore"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/incoming_request_ignore_button"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_incoming_accept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    tools:text="Aceptar por $278" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_incoming_expiry"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progressBackgroundTint="?attr/colorSurfaceVariant"
                android:progressTint="@color/drivo_error"
                tools:progress="600" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
