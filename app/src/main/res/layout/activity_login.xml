<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/app_name"
            android:textColor="?attr/colorPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:text="@string/auth_login_title"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />

        <!-- Paso 1: número de teléfono -->
        <LinearLayout
            android:id="@+id/group_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:prefixText="@string/auth_login_phone_prefix"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_login_phone_hint"
                    android:inputType="number"
                    android:maxLength="10"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/auth_login_send_code_button"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />

            <!-- Separador "o": las dos vías son alternativas equivalentes, no un camino
                 principal y un atajo. Por eso el botón de Google va aquí abajo y no compitiendo
                 con el de continuar, y por eso es outlined: el relleno lo lleva la vía que el
                 usuario ya empezó a escribir. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/auth_login_or"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google_sign_in"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/auth_login_google_button"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null"
                app:strokeColor="?attr/colorOutline" />
        </LinearLayout>

        <!-- Paso 2: código de verificación -->
        <LinearLayout
            android:id="@+id/group_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_code_sent_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_code_0"
                    style="@style/Widget.Drivo.OtpDigit"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/input_code_1"
                    style="@style/Widget.Drivo.OtpDigit"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/input_code_2"
                    style="@style/Widget.Drivo.OtpDigit"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/input_code_3"
                    style="@style/Widget.Drivo.OtpDigit"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/input_code_4"
                    style="@style/Widget.Drivo.OtpDigit"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/input_code_5"
                    style="@style/Widget.Drivo.OtpDigit" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/auth_login_verify_button"
                android:textAllCaps="false"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/link_change_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="@string/auth_login_change_phone"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
