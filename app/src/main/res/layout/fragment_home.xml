<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btn_open_drawer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/nav_menu_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_menu"
        app:tint="?attr/colorOnSurface" />

    <!-- Reemplaza el botón de ubicación por defecto del SDK de Maps (setMyLocationButtonEnabled
         se deja en false) para que comparta el mismo estilo redondo que el de menú. Antes tenía
         fondo blanco fijo (como en Google Maps) sin seguir el tema; ahora sigue el tema igual
         que btn_open_drawer, con borde para no perderse contra el mapa que también cambia. -->
    <ImageButton
        android:id="@+id/btn_my_location"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/home_my_location_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_my_location"
        app:tint="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/group_peek_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Sin aire extra propio arriba: el modal topa justo debajo de la status bar
                     (HomeFragment.applyTopInsets acota su altura), así que el saludo nunca queda
                     bajo ella y este borde superior mide lo mismo colapsado que expandido. El
                     spacer animado que había aquí compensaba eso por su cuenta y era justo lo
                     que hacía crecer el borde al abrir el teclado, sin volver a encogerlo. -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="?attr/colorOutline" />

                <TextView
                    android:id="@+id/text_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/home_greeting_default"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="¡Hola, Carlos!" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/row_search_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <ImageView
                            android:id="@+id/icon_search_leading"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:contentDescription="@string/home_search_icon_description"
                            android:focusable="true"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <EditText
                            android:id="@+id/input_destination"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/home_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btn_clear_destination"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:contentDescription="@string/home_search_clear_description"
                            android:focusable="true"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/row_pick_on_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_pick_on_map"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Reemplaza a group_default_lists mientras se escribe en input_destination —
                 ver HomeFragment.bindPredictions()/cancelSearch(). -->
            <LinearLayout
                android:id="@+id/container_predictions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/group_default_lists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nivel 2: hasta aquí se ven las últimas 2 direcciones guardadas — fuera de
                     group_peek_content a propósito, ver HomeFragment.updateSheetStops(). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/text_saved_addresses_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/home_saved_addresses"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/container_saved_addresses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="?attr/colorOutline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/home_recent_trips"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/container_recent_trips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tapa la status bar / notch con el mismo color del modal mientras éste sube, para que
         expandido se lea como pantalla completa en vez de dejar ver el mapa por detrás. Su alto
         lo fija HomeFragment.applyTopInsets con el inset real, y su alpha lo anima el
         BottomSheetCallback junto con el redondeo de las esquinas.

         Va después del sheet y con su misma elevación a propósito: así se dibuja por encima y
         cubre la sombra que el sheet proyecta hacia arriba, que si no marcaría una costura
         justo en el límite entre ambos. -->
    <View
        android:id="@+id/scrim_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="?attr/colorSurface"
        android:elevation="12dp" />

    <!-- Aviso de sin conexión, en píldora. Se alinea en la misma fila que los dos botones
         flotantes: mismo alto (44dp) y mismo margen superior (HomeFragment.applyTopInsets le da
         inset + 16dp, igual que a ellos), así los tres centros verticales coinciden. El ancho es
         wrap_content centrado, acotado por 60dp a cada lado = 16dp de margen del botón + 44dp de
         su ancho, de modo que la píldora nunca puede invadirlos por larga que sea la frase. Si
         cambia el tamaño o el margen de btn_open_drawer / btn_my_location, hay que actualizar
         tanto ese 60dp como el alto de aquí.

         Su elevación supera a la del modal (12dp) para seguir siendo visible aunque éste esté
         expandido a pantalla completa. Se muestra y se oculta solo, siguiendo al
         ConnectivityRepository — el usuario no tiene que hacer nada. -->
    <TextView
        android:id="@+id/banner_offline"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_error"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_offline"
        android:textColor="?attr/colorOnError"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Aviso de reconexión — mismo nivel, tamaño y fila que banner_offline (ver comentario
         arriba), pero transitorio: HomeFragment.showReconnectedBanner() lo desvanece solo tras
         unos segundos, no espera a que el usuario haga nada ni a que la señal vuelva a caerse. -->
    <TextView
        android:id="@+id/banner_online"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_online"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_restored"
        android:textColor="@color/drivo_on_success"
        android:textSize="13sp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
