<?xml version="1.0" encoding="utf-8"?>
<!-- Host del flujo del pasajero: un solo mapa para los tres pasos (home → tarifa → radar).
     Las capas van, de abajo a arriba: mapa, botones flotantes, tarjeta de ruta, radar, modal,
     velo de status bar y banners de conectividad. Ver el javadoc de HomeFragment. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Único botón para las dos funciones: abre el menú en el paso IDLE y hace de "atrás" en
         los demás, cambiando solo su ícono con un fundido en el sitio. Un segundo botón que
         apareciera en otra posición al cambiar de paso rompería la continuidad que busca todo
         este rediseño — ver HomeFragment.applyStep(). -->
    <ImageButton
        android:id="@+id/btn_open_drawer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/nav_menu_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_menu"
        app:tint="?attr/colorOnSurface" />

    <!-- Reemplaza el botón de ubicación por defecto del SDK de Maps (setMyLocationButtonEnabled
         se deja en false) para que comparta el mismo estilo redondo que el de menú. Antes tenía
         fondo blanco fijo (como en Google Maps) sin seguir el tema; ahora sigue el tema igual
         que btn_open_drawer, con borde para no perderse contra el mapa que también cambia. -->
    <ImageButton
        android:id="@+id/btn_my_location"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dot_outlined"
        android:contentDescription="@string/home_my_location_description"
        android:elevation="4dp"
        android:padding="10dp"
        android:src="@drawable/ic_my_location"
        app:tint="?attr/colorOnSurface" />

    <!-- Su margen superior lo fija HomeFragment.applyTopInsets: inset + 68dp, justo debajo de la
         fila de botones flotantes (16dp de margen + 44dp de alto + 8dp de aire). -->
    <include
        android:id="@+id/card_route_summary"
        layout="@layout/card_route_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- Pin fijo del paso PICK_LOCATION: el mapa se arrastra debajo de él. Centrado en el hueco
         visible igual que el radar (HomeFragment.updateMapViewport les da a ambos los mismos
         márgenes). translationY sube la punta del pin al punto exacto, igual que en el layout
         original de la Activity que absorbió. -->
    <ImageView
        android:id="@+id/img_pick_location_pin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:contentDescription="@string/pick_location_pin_description"
        android:src="@drawable/ic_map_pin"
        android:translationY="-18dp"
        android:visibility="gone"
        app:tint="@color/drivo_secondary" />

    <!-- Pin fijo del paso PICK_STOP: mismo patrón que img_pick_location_pin, pero teñido del
         color que MapPresenter usa para los puntos intermedios de la ruta (drivo_primary), para
         que el pin anticipe el color del marcador que va a dejar. -->
    <ImageView
        android:id="@+id/img_pick_stop_pin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:contentDescription="@string/pick_stop_pin_description"
        android:src="@drawable/ic_map_pin"
        android:translationY="-18dp"
        android:visibility="gone"
        app:tint="@color/drivo_primary" />

    <!-- El radar del paso SEARCHING ya NO es una View aquí: eran dos anillos centrados en la
         pantalla (layout_gravity="center") que se desacoplaban del punto de recogida real en
         cuanto el mapa se reencuadraba (p. ej. al cambiar el alto del modal), porque esta View
         vivía en coordenadas de pantalla en vez de coordenadas de mapa. Ahora son dos Circle de
         Google Maps anclados a viewModel.getOrigin() — ver HomeFragment.createRadarCircles()/
         startRadarPulse(): al vivir en el mismo espacio de coordenadas que cualquier otro overlay
         del mapa, el SDK los reproyecta solos con cualquier cambio de cámara. -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <!-- Un solo hijo con los tres paneles: solo uno está VISIBLE a la vez y el modal se
             ajusta a su alto (HomeFragment.updateSheetStops). Cambiar de paso es un fundido
             cruzado entre paneles, no una transición de pantalla. -->
        <FrameLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/panel_home"
                layout="@layout/panel_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/panel_pick_location"
                layout="@layout/panel_pick_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/panel_pick_stop"
                layout="@layout/panel_pick_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/panel_confirm_price"
                layout="@layout/panel_confirm_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/panel_searching"
                layout="@layout/panel_searching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tapa la status bar / notch con el mismo color del modal mientras éste sube, para que
         expandido se lea como pantalla completa en vez de dejar ver el mapa por detrás. Su alto
         lo fija HomeFragment.applyTopInsets con el inset real, y su alpha lo anima el
         BottomSheetCallback junto con el redondeo de las esquinas.

         Va después del sheet y con su misma elevación a propósito: así se dibuja por encima y
         cubre la sombra que el sheet proyecta hacia arriba, que si no marcaría una costura
         justo en el límite entre ambos. -->
    <View
        android:id="@+id/scrim_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="?attr/colorSurface"
        android:elevation="12dp" />

    <!-- Aviso de sin conexión, en píldora. Se alinea en la misma fila que los dos botones
         flotantes: mismo alto (44dp) y mismo margen superior (HomeFragment.applyTopInsets le da
         inset + 16dp, igual que a ellos), así los tres centros verticales coinciden. El ancho es
         wrap_content centrado, acotado por 60dp a cada lado = 16dp de margen del botón + 44dp de
         su ancho, de modo que la píldora nunca puede invadirlos por larga que sea la frase. Si
         cambia el tamaño o el margen de btn_open_drawer / btn_my_location, hay que actualizar
         tanto ese 60dp como el alto de aquí.

         Su elevación supera a la del modal (12dp) para seguir siendo visible aunque éste esté
         expandido a pantalla completa. Se muestra y se oculta solo, siguiendo al
         ConnectivityRepository — el usuario no tiene que hacer nada. -->
    <TextView
        android:id="@+id/banner_offline"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_error"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_offline"
        android:textColor="?attr/colorOnError"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Aviso de reconexión — mismo nivel, tamaño y fila que banner_offline (ver comentario
         arriba), pero transitorio: HomeFragment.showReconnectedBanner() lo desvanece solo tras
         unos segundos, no espera a que el usuario haga nada ni a que la señal vuelva a caerse. -->
    <TextView
        android:id="@+id/banner_online"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_pill_online"
        android:elevation="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:text="@string/connectivity_restored"
        android:textColor="@color/drivo_on_success"
        android:textSize="13sp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
