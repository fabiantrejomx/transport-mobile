<?xml version="1.0" encoding="utf-8"?>
<!-- Un viaje al que el conductor ya se postuló, flotando sobre el mapa.

     Sustituye a la pantalla de espera que había antes: ofertar no bloquea al conductor, así que
     el modal vuelve al radar y la oferta se queda aquí, siempre a la vista, mientras él sigue
     recibiendo y evaluando otras solicitudes. Se lee de reojo y a veces manejando, así que trae
     tres datos y nada más: a dónde va, cuánto ofertó, y cuánto le queda. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_offer_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <View
                android:id="@+id/dot_banner_state"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/drivo_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_banner_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Plaza Valle Orizaba" />

                <TextView
                    android:id="@+id/text_banner_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="Ofertaste $290.00 · el pasajero decide" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_banner_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1:23" />
        </LinearLayout>

        <!-- Mismo plazo que ve el pasajero: la subasta corre con un solo reloj. -->
        <ProgressBar
            android:id="@+id/progress_banner_expiry"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:progressTint="@color/drivo_secondary"
            tools:progress="600" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
