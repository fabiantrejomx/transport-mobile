<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_prediction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_map_pin"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- Un solo texto (AutocompletePrediction.getFullText) en vez de partirlo en primary/secondary:
         ese texto de Google no siempre coincide con el formatted_address que Place Details
         devuelve al seleccionar (ver PlacesAutocompleteService.resolvePlace), así que mostrar dos
         líneas con jerarquía visual distinta (nombre en negrita + dirección) sugería una precisión
         que luego no se sostenía al elegir el resultado. -->
    <TextView
        android:id="@+id/text_prediction_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        tools:text="Torre Reforma, Paseo de la Reforma 483, CDMX" />
</LinearLayout>
