<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera del drawer del pasajero: quién eres, sin más. Es la misma pieza que la del conductor
     (nav_header_driver.xml) menos las casillas de saldo y viajes — el pasajero no tiene esas
     cifras, y no hay nada que inventar para llenar el hueco.

     El paddingTop de 20dp lo recalcula DrawerInsets al abrirse el cajón, sumándole el inset de la
     status bar; minWidth de 280dp porque el NavigationView es wrap_content y si no, el ancho del
     cajón lo decidiría el item de menú más largo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_header_passenger"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minWidth="280dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/text_nav_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:gravity="center"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="AG" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_nav_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Alfonso González" />

        <TextView
            android:id="@+id/text_nav_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="+52 272 123 4567" />
    </LinearLayout>
</LinearLayout>
