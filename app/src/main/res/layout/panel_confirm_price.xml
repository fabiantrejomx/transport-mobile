<?xml version="1.0" encoding="utf-8"?>
<!-- Panel del paso CONFIRM_PRICE dentro del modal de HomeFragment: tarifa negociable, método de
     pago y solicitar. Era la tarjeta inferior de activity_confirm_price.xml, que además arrastraba
     su propio mapa; ahora comparte el mapa del home y solo cambia el contenido del modal.

     Sin tirador arriba: en este paso el modal no se arrastra (HomeFragment lo fija con
     setDraggable(false)) y un tirador prometería un gesto que no existe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/confirm_price_label"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/text_price_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="$278.00" />

        <!-- invisible, no gone: el alto del panel debe ser el mismo cargando o cargado, sin
             importar cuándo llega la respuesta de /quotes respecto al fundido del panel. -->
        <ProgressBar
            android:id="@+id/progress_quote"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:visibility="invisible" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:thumbColor="?attr/colorSecondary"
        app:trackColorActive="?attr/colorSecondary"
        app:trackColorInactive="?attr/colorSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_price_min"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="$222 (80%)" />

        <TextView
            android:id="@+id/text_price_max"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="$389 (140%)" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_payment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_price_payment_cash"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_request_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/drivo_success"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/confirm_price_request_trip"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="16dp" />

    <!-- Única salida visible de este paso: aquí ya no hay flecha flotante (ver
         HomeFragment.applyStep). Va como TextButton y no Outlined a propósito — pegado a un CTA
         verde de ancho completo, el peso visual bajo reduce el toque por error y es lo más barato
         en alto, que es lo que la tarjeta de ruta acaba de ganar arriba. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_trip"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/confirm_price_cancel"
        android:textAllCaps="false"
        app:cornerRadius="16dp" />
</LinearLayout>
