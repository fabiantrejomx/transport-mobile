<?xml version="1.0" encoding="utf-8"?>
<!-- Panel intermedio tras aceptar o contraofertar. Existe porque antes ofertar simplemente
     cerraba la tarjeta y devolvía al radar sin decir nada: no quedaba ni rastro de que se había
     enviado algo, ni por cuánto. El contrato no permite esperar aquí (el conductor sigue
     recibiendo viajes mientras tanto), así que este panel no bloquea: se puede cerrar con
     "Seguir buscando viajes" y se cierra solo si llega otra solicitud. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="?attr/colorOutline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:id="@+id/text_offer_sent_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/driver_offer_sent_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_offer_sent_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        tools:text="Le enviaste $288.00 a Esteban G. Si acepta, recibirás una notificación y el viaje se abrirá desde ahí." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_offer_sent_dismiss"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="14dp"
        android:text="@string/driver_offer_sent_dismiss"
        android:textAllCaps="false"
        app:cornerRadius="26dp" />
</LinearLayout>
