<?xml version="1.0" encoding="utf-8"?>
<!-- Panel del paso IDLE dentro del modal de HomeFragment: saludo, buscador de destino,
     "elegir en el mapa", direcciones guardadas y últimos viajes. Vive en su propio archivo
     desde que el modal pasó a alojar también los pasos de tarifa y radar (ver el javadoc de
     HomeFragment); antes era el único contenido posible y estaba inline en fragment_home.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/group_peek_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Sin aire extra propio arriba: el modal topa justo debajo de la status bar
             (HomeFragment.applyTopInsets acota su altura), así que el saludo nunca queda
             bajo ella y este borde superior mide lo mismo colapsado que expandido. El
             spacer animado que había aquí compensaba eso por su cuenta y era justo lo
             que hacía crecer el borde al abrir el teclado, sin volver a encogerlo. -->
        <View
            android:id="@+id/handle_home"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="?attr/colorOutline" />

        <TextView
            android:id="@+id/text_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/home_greeting_default"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="¡Hola, Carlos!" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/row_search_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:id="@+id/icon_search_leading"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="@string/home_search_icon_description"
                    android:focusable="true"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/input_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/home_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_clear_destination"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:contentDescription="@string/home_search_clear_description"
                    android:focusable="true"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/row_pick_on_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_map_pin"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_pick_on_map"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Estado de texto de las unidades cercanas. Nace GONE y solo aparece cuando
             GET /nearby-drivers responde sin unidades — ver HomeFragment.onNearbyStatusChanged().
             Va dentro de group_peek_content para que se vea con el modal colapsado, que es donde
             el pasajero está mirando el mapa; su alto entra en el corte del modal, y como este se
             mide en cada pase de layout (updateSheetStops) aparecer y desaparecer no lo descuadra. -->
        <TextView
            android:id="@+id/text_nearby_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:text="@string/home_nearby_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Reemplaza a group_default_lists mientras se escribe en input_destination —
         ver HomeFragment.bindPredictions()/cancelSearch(). -->
    <LinearLayout
        android:id="@+id/container_predictions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/group_default_lists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nivel 2: hasta aquí se ven las últimas direcciones guardadas — fuera de
             group_peek_content a propósito, ver HomeFragment.updateSheetStops(). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/text_saved_addresses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/home_saved_addresses"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/container_saved_addresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="?attr/colorOutline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/home_recent_trips"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/container_recent_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
