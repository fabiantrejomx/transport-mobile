<?xml version="1.0" encoding="utf-8"?>
<!-- Panel del paso PICK_STOP dentro del modal de HomeFragment: las tres formas de elegir un
     punto conviven aquí, igual que en Home para el destino — buscar por texto (con
     predicciones), tocar una dirección guardada, o arrastrar el pin fijo sobre el mapa (que
     sigue visible detrás, con la ruta origen-destino ya trazada). El input hace las dos veces:
     por defecto muestra la dirección bajo el pin, y en cuanto el usuario escribe se convierte en
     el buscador — ver PickStopPanel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/pick_stop_search_icon_description"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/input_stop_query"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/pick_stop_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                tools:text="Calle Reforma 22, Centro, Orizaba" />

            <ImageView
                android:id="@+id/btn_stop_clear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="@string/pick_stop_search_clear_description"
                android:focusable="true"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reemplaza a group_stop_default_list mientras se escribe en input_stop_query. -->
    <LinearLayout
        android:id="@+id/container_stop_predictions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Sin este aviso, una búsqueda sin resultados dejaba el modal expandido y completamente
         vacío (la lista de direcciones guardadas ya se ocultó y no hay predicciones que poner en
         su lugar), sin nada que dijera que la búsqueda sí corrió. -->
    <TextView
        android:id="@+id/text_stop_no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:text="@string/pick_stop_no_results"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/group_stop_default_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_stop_saved_addresses_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/home_saved_addresses"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/container_stop_saved_addresses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Los botones comparten ranura y nunca se ven a la vez (ver PickStopPanel.applySearchChrome).
         En reposo: confirmar la parada, o cancelar y salir del paso — este último existe porque la
         flecha flotante de "atrás" es el único otro modo de salir y no se lee como tal, y encima
         queda tapada por el modal en cuanto se expande el buscador.
         Buscando: los sustituye "Cancelar búsqueda", que solo deshace la búsqueda. "Confirmar
         parada" se esconde ahí a propósito — el pin está congelado mientras se busca, así que
         confirmarlo no sería lo que el usuario está pidiendo. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/pick_stop_confirm"
        android:textAllCaps="false"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_stop"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/pick_stop_cancel"
        android:textAllCaps="false"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_stop_search"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="@string/pick_stop_cancel_search"
        android:textAllCaps="false"
        android:visibility="gone"
        app:cornerRadius="16dp" />
</LinearLayout>
