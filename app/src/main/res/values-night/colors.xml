    <color name="drivo_secondary_container">#614502</color>
    <color name="drivo_on_secondary_container">#FFF5DF</color>

    <!-- Ver el comentario en values/colors.xml: sobre la superficie oscura el amarillo de marca
         se lee perfecto (10:1), así que aquí no hace falta oscurecerlo. -->
    <color name="drivo_secondary_fg">#FFC21A</color>

    <color name="drivo_background">#0A1711</color>
