    <color name="drivo_outline">#354B3E</color>
    <color name="drivo_outline_variant">#354B3E</color>
    <color name="drivo_on_surface_border">#66F2FAF5</color>

    <color name="drivo_error">#EA7162</color>
    <color name="drivo_on_error">#10251A</color>

    <!-- El verde claro de la escala (green-300), el mismo de la ruta en los mockups oscuros;
         con texto oscuro encima, como el resto de los rellenos claros de este tema. -->
    <color name="drivo_success">#95CEA1</color>
    <color name="drivo_on_success">#10251A</color>

    <color name="drivo_warning">#E8A200</color>
    <color name="drivo_on_warning">#10251A</color>

    <!-- Ver el comentario en values/colors.xml: aquí sí puede ser el amarillo de marca, que es
         lo que de verdad se lee sobre el mapa oscuro. -->
    <color name="drivo_map_accent">#FFC21A</color>

    <!-- Ver el comentario en values/colors.xml: blanco sobre el mapa oscuro, como en los mockups. -->
    <color name="drivo_map_destination">#FFFFFF</color>

    <!-- Ver el comentario en values/colors.xml. Aquí todo se invierte: carrocería clara (un blanco
         roto, no puro, para que los realces del techo no se pierdan) y detalles en gris verdoso,
         que es lo que le devuelve al coche las ventanas y las llantas sobre el mapa oscuro. -->
    <color name="drivo_vehicle_body">#F2FAF5</color>
    <color name="drivo_vehicle_outline">#FF4C5B52</color>
    <color name="drivo_vehicle_roof">#2410251A</color>
    <color name="drivo_vehicle_glass">#8C33433A</color>
    <color name="drivo_vehicle_glass_soft">#7333433A</color>
    <color name="drivo_vehicle_wheel">#B310251A</color>
    <color name="drivo_vehicle_mirror">#8C10251A</color>

    <!-- Ver el comentario en values/colors.xml. Mismos tres, invertidos: faros oscuros sobre la
         carrocería clara, calavera un poco más quemada para que no se pierda. -->
    <color name="drivo_vehicle_headlight">#7310251A</color>
    <color name="drivo_vehicle_taillight">#FF8A4E22</color>
    <color name="drivo_vehicle_highlight">#2910251A</color>

    <color name="drivo_scrim">#E610251A</color>

    <!-- Ver el comentario en values/colors.xml: aquí es el par surface/on_surface del tema claro. -->
    <color name="drivo_inverse_surface">#FFFFFF</color>
    <color name="drivo_inverse_on_surface">#10251A</color>
