<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta de marca Drivo (modo claro) — ver CLAUDE.md -->
    <color name="drivo_primary">#0F2C4C</color>
    <color name="drivo_on_primary">#FFFFFF</color>
    <color name="drivo_primary_container">#D5E3F7</color>
    <color name="drivo_on_primary_container">#0F2C4C</color>

    <color name="drivo_secondary">#B08D2B</color>
    <color name="drivo_on_secondary">#FFFFFF</color>
    <color name="drivo_secondary_container">#F3E4C0</color>
    <color name="drivo_on_secondary_container">#4A3900</color>

    <color name="drivo_background">#F6F8FA</color>
    <color name="drivo_on_background">#14212E</color>
    <color name="drivo_surface">#FFFFFF</color>
    <color name="drivo_on_surface">#14212E</color>
    <color name="drivo_surface_variant">#EEF2F6</color>
    <color name="drivo_on_surface_variant">#55677A</color>
    <color name="drivo_outline">#D6DEE6</color>
    <!-- drivo_on_surface al 40% de opacidad — borde de los botones flotantes sobre el mapa
         (bg_dot_outlined.xml): perceptible sin ser tan marcado como el color sólido. -->
    <color name="drivo_on_surface_border">#6614212E</color>

    <color name="drivo_error">#B3261E</color>
    <color name="drivo_on_error">#FFFFFF</color>

    <!-- Color de confirmaciones / punto de origen en el mapa (fuera de los roles estándar de M3,
         no hay colorSuccess en el theme — se referencia siempre como @color, nunca como ?attr) -->
    <color name="drivo_success">#2E7D5B</color>
    <color name="drivo_on_success">#FFFFFF</color>

    <!-- Azul de mapa: tramo conductor→pasajero, marcador del coche y paradas intermedias.
         Tiene variante propia en values-night en vez de usar drivo_primary directo porque sobre
         el mapa oscuro el azul marino de marca (#0F2C4C) queda casi invisible — el mapa no es una
         superficie del tema, así que un color pensado para contrastar contra colorSurface no
         sirve aquí. Se referencia siempre como @color, nunca como ?attr. -->
    <color name="drivo_map_accent">#0F2C4C</color>

    <!-- Marcador de vehículo (MarkerIconFactory.carMarker) — el coche del conductor, tanto el
         suyo propio como el que ve el pasajero. Se invierte con el tema para destacar sobre el
         mapa: carrocería oscura sobre el mapa claro y clara sobre el oscuro (ver values-night).

         Los detalles NO pueden ser un color fijo: son lo que dibuja parabrisas, techo y llantas
         encima de la carrocería, así que tienen que contrastar contra ella y por tanto invertirse
         con el tema igual que ella. Con blanco fijo, en tema oscuro quedaban blanco sobre blanco
         y el coche se veía como una mancha sin detalle. -->
    <color name="drivo_vehicle_body">#142130</color>
    <color name="drivo_vehicle_outline">#FFFFFFFF</color>
    <color name="drivo_vehicle_roof">#2EFFFFFF</color>
    <color name="drivo_vehicle_glass">#A6FFFFFF</color>
    <color name="drivo_vehicle_glass_soft">#8CFFFFFF</color>
    <color name="drivo_vehicle_wheel">#8C000000</color>
    <color name="drivo_vehicle_mirror">#66000000</color>

    <!-- Faros, calaveras y brillo de cofre — el detalle que hace que el sprite se lea como un
         auto y no solo como una silueta. Mismo criterio de contraste que el resto: se invierten
         con el tema (ver values-night). La calavera es un ámbar quemado y no el dorado de marca
         a propósito: ese dorado ya significa "confirmar/negociar" en el resto de la app. -->
    <color name="drivo_vehicle_headlight">#D9FFFFFF</color>
    <color name="drivo_vehicle_taillight">#FFC77B3D</color>
    <color name="drivo_vehicle_highlight">#33FFFFFF</color>

    <!-- Scrim tras texto sobre el mapa (ej. radar de búsqueda) — mismo tono que la superficie, semitransparente -->
    <color name="drivo_scrim">#E6FFFFFF</color>

    <!-- Superficie invertida: literalmente el par surface/on_surface del OTRO tema (ver
         values-night/colors.xml). Para elementos flotantes sobre el mapa que necesitan contrastar
         a propósito contra el tema activo en vez de mezclarse con él: "Navegar con Waze"
         (bg_pill_inverse.xml) y la carrocería de MarkerIconFactory.carMarker(), que además ya
         trae su propio borde blanco (ic_car_marker_detail.xml) para no perderse contra el mapa. -->
    <color name="drivo_inverse_surface">#142130</color>
    <color name="drivo_inverse_on_surface">#E7EDF3</color>
</resources>
