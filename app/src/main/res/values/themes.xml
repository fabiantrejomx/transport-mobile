<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Drivo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/drivo_primary</item>
        <item name="colorOnPrimary">@color/drivo_on_primary</item>
        <item name="colorPrimaryContainer">@color/drivo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/drivo_on_primary_container</item>

        <item name="colorSecondary">@color/drivo_secondary</item>
        <item name="colorOnSecondary">@color/drivo_on_secondary</item>
        <item name="colorSecondaryContainer">@color/drivo_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/drivo_on_secondary_container</item>

        <item name="android:colorBackground">@color/drivo_background</item>
        <item name="colorOnBackground">@color/drivo_on_background</item>
        <item name="colorSurface">@color/drivo_surface</item>
        <item name="colorOnSurface">@color/drivo_on_surface</item>
        <item name="colorSurfaceVariant">@color/drivo_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/drivo_on_surface_variant</item>
        <item name="colorOutline">@color/drivo_outline</item>

        <item name="colorError">@color/drivo_error</item>
        <item name="colorOnError">@color/drivo_on_error</item>
    </style>

    <style name="Widget.Drivo.OtpDigit" parent="android:Widget.EditText">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_otp_digit</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
